#!/usr/bin/env bash
set -euo pipefail

HOLDS=(
    intel-ucode=20260811-1
)

readonly AUR_MIN_AGE_SECONDS=$((24 * 60 * 60))

# This is a local option, not a yay option.  Strip it before passing the
# remaining arguments on to yay.
ignore_aur_age=false
yay_args=()
for arg in "$@"; do
    case $arg in
        --ignore-aur-age)
            ignore_aur_age=true
            ;;
        *)
            yay_args+=("$arg")
            ;;
    esac
done

sudo -v

battery_capacities=()
for capacity_file in /sys/class/power_supply/BAT*/capacity; do
    [[ -r $capacity_file ]] || continue
    read -r capacity <"$capacity_file"
    [[ $capacity =~ ^[0-9]+$ ]] && battery_capacities+=("$capacity")
done

on_ac_power=false
for power_supply in /sys/class/power_supply/*; do
    [[ -r $power_supply/type && -r $power_supply/online ]] || continue
    [[ $(<"$power_supply/type") == Mains ]] || continue

    read -r online <"$power_supply/online"
    [[ $online == 1 ]] && on_ac_power=true
done

update_firmware=$on_ac_power
if ! "$on_ac_power" && ((${#battery_capacities[@]})); then
    update_firmware=true
    for capacity in "${battery_capacities[@]}"; do
        if ((capacity <= 50)); then
            printf 'Battery charge is %s%% (must be greater than 50%%); skipping firmware updates.\n' "$capacity" >&2
            update_firmware=false
            break
        fi
    done
fi

if "$update_firmware"; then
    sudo fwupdmgr refresh --force >/dev/null
    firmware_updates=$(sudo fwupdmgr get-updates --json --no-unreported-check)
    mapfile -t firmware_update_devices < <(
        jq -r '
            def changelog:
                gsub("<li[^>]*>"; "\n- ")
                | gsub("</li>"; "")
                | gsub("<br[^>]*>"; "\n")
                | gsub("</p>"; "\n")
                | gsub("<p[^>]*>"; "")
                | gsub("<[^>]+>"; "")
                | gsub("&amp;"; "&")
                | gsub("&lt;"; "<")
                | gsub("&gt;"; ">")
                | gsub("^[[:space:]]+|[[:space:]]+$"; "")
                | gsub("\n"; "\n    ");

            .Devices[]?
            | select((.Flags // []) | index("updatable") != null or index("updatable-hidden") != null)
            | select((.Releases // []) | length > 0)
            | "\(.Name) (\(.Version // "unknown") → \(.Releases[0].Version // "unknown"))\n  Changes:\n    \((.Releases[0].Description // .Releases[0].Summary // "No changelog provided by the vendor.") | changelog)"
        ' <<<"$firmware_updates"
    )

    if ((${#firmware_update_devices[@]})); then
        printf '\nAvailable firmware updates:\n'
        printf ' • %s\n' "${firmware_update_devices[@]}"
        read -rp 'Install these firmware updates after package updates? [y/N] ' reply
        if [[ $reply == [yY] || $reply == [yY][eE][sS] ]]; then
            update_firmware=true
        else
            update_firmware=false
            printf 'Skipping firmware updates.\n'
        fi
    else
        update_firmware=false
        printf 'No firmware updates are available.\n'
    fi
elif ((${#battery_capacities[@]} == 0)); then
    printf 'No battery capacity or AC power detected; skipping firmware updates.\n' >&2
fi

yay -Sy

ignore=()
while read -r pkg _ _ new _; do
    for hold in "${HOLDS[@]}"; do
        [[ $hold == "$pkg" ]] && ignore+=("$pkg")
        [[ $hold == "$pkg="* && $new == ${hold#*=} ]] && ignore+=("$pkg")
    done
done < <(yay -Qu </dev/null || true)

if ! "$ignore_aur_age"; then
    now=$(date +%s)
    if ! aur_update_output=$(yay -Qua --quiet </dev/null); then
        printf 'Unable to query AUR updates; skipping AUR packages.\n' >&2
        aur_update_output=$(yay -Qqm)
    fi

    while read -r pkg; do
        [[ -z $pkg ]] && continue

        last_modified=$(curl --fail --silent --show-error --get \
            --data-urlencode "arg[]=$pkg" \
            'https://aur.archlinux.org/rpc/v5/info' |
            jq -r --arg pkg "$pkg" '.results[] | select(.Name == $pkg) | .LastModified' |
            head -n1) || {
                printf 'Unable to determine the AUR age of %s; skipping it.\n' "$pkg" >&2
                ignore+=("$pkg")
                continue
            }

        if [[ ! $last_modified =~ ^[0-9]+$ ]]; then
            printf 'Unable to determine the AUR age of %s; skipping it.\n' "$pkg" >&2
            ignore+=("$pkg")
        elif ((now - last_modified < AUR_MIN_AGE_SECONDS)); then
            printf 'Skipping AUR package updated less than 24 hours ago: %s\n' "$pkg" >&2
            ignore+=("$pkg")
        fi
    done <<<"$aur_update_output"
fi

if ((${#ignore[@]})); then
    yay -Su --noconfirm --diffmenu --answerdiff All --ignore "$(IFS=,; echo "${ignore[*]}")" "${yay_args[@]}"
else
    yay -Su --noconfirm --diffmenu --answerdiff All "${yay_args[@]}"
fi

if "$update_firmware"; then
    sudo fwupdmgr update --assume-yes --no-reboot-check
fi
